#!/usr/bin/env bash
# typelessctl — Typeless for macOS 的命令行控制器（非官方工具）
# 能力通道（全部一手实测/源码定位，2026-10）：
#   AX 点关闭钮（不重启 App）、electron-store 设置读写、typeless.db 历史导出、launchd 静默守卫。
# 红线：绝不读取 app-storage.json（含账号会话）；导出的历史文件默认仅用户可读。
set -uo pipefail

APP_PATH="${TYPELESSCTL_APP_PATH:-/Applications/Typeless.app}"
APP_NAME="Typeless"
# 解析符号链接：install.sh 把本脚本链到 ~/.local/bin；dirname($0) 在经符号链接调用时会解析到
# 链接所在目录 → lib/close-hub.applescript 找不到、守卫 tick 静默空转（2026-10-17 发现）。
# bash 3.2 兼容：readlink 无 -f，单跳循环解析；tick 热路径不新增子进程。
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _t="$(readlink "$_src")"
  case "$_t" in
    /*) _src="$_t" ;;
    *)  _src="$(cd "$(dirname "$_src")" && pwd)/$_t" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$_src")/.." && pwd)"
APPLESCRIPT="$SCRIPT_DIR/lib/close-hub.applescript"
STATE_DIR="${TYPELESSCTL_STATE:-$HOME/.typelessctl}"
LOG_FILE="$STATE_DIR/guard.log"
LABEL="dev.zcode.typelessctl-guard"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
APP_SUPPORT="$HOME/Library/Application Support/Typeless"
SETTINGS="${TYPELESSCTL_SETTINGS:-$APP_SUPPORT/app-settings.json}"
DB="${TYPELESSCTL_DB:-$APP_SUPPORT/typeless.db}"
GRACE_SECONDS="${TYPELESSCTL_GRACE:-15}"
JSON=0

# 退出码契约（稳定、可脚本判断）：0 成功 2 用法错 3 权限缺 4 不支持 5 数据读写失败 6 结果未核验
die() { echo "typelessctl: $*" >&2; exit "${2:-2}"; }

app_pid()  { pgrep -x "$APP_NAME" 2>/dev/null | head -1; }
app_secs() { # 进程运行秒数；etime 形如 [[dd-]hh:]mm:ss
  local et; et="$(ps -p "$1" -o etime= | tr -d ' ')"
  printf '%s' "$et" | awk '{s=$0;d=0;if(index(s,"-")){split(s,p,"-");d=p[1]+0;s=p[2]}
    n=split(s,c,":");if(n==3)print d*86400+c[1]*3600+c[2]*60+c[3];else print d*86400+c[1]*60+c[2]}'
}
windows() { osascript -e "tell application \"System Events\" to tell process \"$APP_NAME\" to get name of every window" 2>/dev/null; }
# 读窗口并区分「读到（可能为空）」与「失败」：失败时返回 1，调用方不得当成"无窗口"。
# osascript 在进程不存在/AX 权限缺失时返回非 0；读到窗口列表（含空列表）返回 0。
windows_ok() { # 成功时用 REPLY 返回窗口串（可能为空）；失败返回 1
  local out rc
  out="$(osascript -e "tell application \"System Events\" to tell process \"$APP_NAME\" to get name of every window" 2>&1)"; rc=$?
  if [ $rc -ne 0 ]; then REPLY=""; return 1; fi
  case "$out" in *"not allowed"*|*"not authorized"*|*"assistive"*|*"-1719"*) REPLY=""; return 1;; esac
  REPLY="$out"; return 0
}

cmd_status() {
  local pid et secs wins guard dock
  pid="$(app_pid)"
  if [ -n "$pid" ]; then
    et="$(app_secs "$pid")"; wins="$(windows)"; guard="unknown"
  else pid="(not running)"; et=""; wins=""; fi
  guard="$(launchctl list 2>/dev/null | awk -v l="$LABEL" '$3==l{print "loaded (last exit "$2")"}' || true)"
  [ -z "$guard" ] && guard="not installed"
  dock="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("enableShowAppInDock",""))' "$SETTINGS" 2>/dev/null | tr -d '\n')"
  case "$dock" in True|true) dock=true;; False|false) dock=false;; *) dock="";; esac   # 读不到→空(未知)，不伪装成 false
  if [ "$JSON" = 1 ]; then
    # 用 python3 生成 JSON（正确转义反斜杠/引号/控制字符），避免手工拼接出非法 JSON
    RUNNING=$([ -n "$(app_pid)" ] && echo true || echo false) \
    PID="${pid}" ETIME="${et}" WINS="${wins}" GUARD="${guard}" DOCK="${dock:-}" \
    python3 -c 'import json,os;d=os.environ["DOCK"];print(json.dumps({"running":os.environ["RUNNING"]=="true","pid":os.environ["PID"],"uptime_seconds":os.environ["ETIME"],"windows":os.environ["WINS"],"guard":os.environ["GUARD"],"show_in_dock":(None if d=="" else d=="true")}))'
  else
    echo "app:        ${pid} $([ -n "$(app_pid)" ] && echo "(running ${et}s)")"
    echo "windows:    ${wins:-（无/未运行）}"
    echo "guard:      $guard"
    echo "dock:       enableShowAppInDock=${dock}（false=不进 Dock）"
    echo "state:      $STATE_DIR  paused=$([ -f "$STATE_DIR/PAUSED" ] && echo yes || echo no)"
  fi
}

cmd_doctor() {
  check() { # check <能力> <available|unsupported|permission_required|missing> <说明>
    printf '  %-18s %-19s %s\n' "$1" "$2" "$3"
  }
  echo "typelessctl doctor"
  local ver; ver="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP_PATH/Contents/Info.plist" 2>/dev/null)"
  if [ -d "$APP_PATH" ]; then check "app-installed" available "$APP_PATH (v${ver:-?})"
  else check "app-installed" missing "${APP_PATH} 不存在"; fi
  if [ ! -f "$APPLESCRIPT" ]; then check "cli-assets" missing "close-hub.applescript 不在 $APPLESCRIPT"; fi
  # AX 权威判据是 System Events 的 `UI elements enabled`：读进程名无需权限、不能当凭据（review 遗留#15）
  local ax; ax="$(osascript -e 'tell application "System Events" to return UI elements enabled' 2>/dev/null)"
  if [ "$ax" = "true" ]; then
    check "accessibility(AX)" available "UI elements enabled（System Events 有权操控他窗）"
  else
    check "accessibility(AX)" permission_required "请：系统设置→隐私与安全性→辅助功能，勾选你运行本命令的终端（当前 UI elements enabled=${ax}）"
  fi
  if [ -f "$SETTINGS" ]; then check "settings-json" available "$SETTINGS"
  else check "settings-json" missing "App 尚未生成设置文件"; fi
  if [ -f "$DB" ] && sqlite3 -readonly "$DB" "SELECT count(*) FROM history_v2;" >/dev/null 2>&1; then
    check "history-db" available "$(sqlite3 -readonly "$DB" 'SELECT count(*) FROM history_v2' 2>/dev/null) 条记录（明文可读）"
  else check "history-db" missing "typeless.db 不可读或表缺失"; fi
  if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
    check "guard" available "launchd 已注册，每 2s 巡查"
  else
    check "guard" missing "运行: typelessctl guard install"
  fi
  [ "$JSON" = 1 ] && echo "（--json doctor 输出开发中，当前为表格）"
  echo "注：CDP 调试端口/改包两条通道已被证实不可用，本工具不依赖。"
}

cmd_app() {
  case "${1:-status}" in
    launch) open -a "$APP_PATH";;
    quit)   osascript -e "tell application \"$APP_NAME\" to quit" 2>/dev/null;;
    status) cmd_status;;
    *) die "用法: typelessctl app {launch|quit|status}";;
  esac
}

cmd_hub() {
  case "${1:-status}" in
    close)
      local pid; pid="$(app_pid)"
      [ -z "$pid" ] && die "App 未运行" 4      # 用 PID 判活，不用「窗口为空」
      windows_ok || die "读不到窗口（可能 AX 权限缺失）" 3
      local before="$REPLY" after
      if ! printf '%s' "$before" | grep -qE '(^|, ?)(Typeless|Onboarding[^,]*)($|,)'; then
        echo "无需关闭：当前没有主界面/引导窗口（剩余: ${before:-无}）"; exit 0
      fi
      osascript "$APPLESCRIPT" >/dev/null 2>&1   # 点击动作；不以它的返回值当结论，下面读回核验
      sleep 1
      # 读回核验：读失败时不得当作"已关闭"（否则权限问题会伪装成成功）
      windows_ok || die "关闭后无法读回窗口（AX 权限或 App 状态异常），结果未核验" 6
      after="$REPLY"
      if printf '%s' "$after" | grep -qE '(^|, ?)(Typeless|Onboarding[^,]*)($|,)'; then
        echo "窗仍存在（关闭未生效）：$after" >&2; exit 6
      else
        echo "已关闭（剩余窗口: ${after:-无}）"
      fi;;
    status) windows;;
    show) die "hub show 未验证：手动唤回主界面的原生入口是 App 托盘菜单（GUI），CLI 不模拟焦点操作。临时放行：typelessctl pause" 4;;
    *) die "用法: typelessctl hub {close|status|show}";;
  esac
}

cmd_bootcheck() {
  # 开机后专用自检：验证「登录自启 + 静默 + 守卫」三件套是否如期。重启后跑一次即可。
  # 约定：chk 第二参为 shell 退出码语义，0=真=PASS。
  local fails=0
  chk() { if [ "$2" = 0 ]; then echo "  PASS  $1"; else echo "  FAIL  $1"; fails=$((fails+1)); fi; }
  echo "typelessctl bootcheck"
  local pid wins dock
  # AX 权限前置检查：读不到窗口时后续「只剩浮动条」不能算 PASS，否则权限失效会伪装成静默成功
  local ax_ok=1
  osascript -e 'tell application "System Events" to get name of every process' >/dev/null 2>&1 && ax_ok=0
  [ "$ax_ok" = 0 ]; chk "辅助功能(AX)权限可用" $?
  pid="$(app_pid)"
  [ -n "$pid" ]; chk "App 进程在跑（登录项自启生效）" $?
  if windows_ok; then
    wins="$REPLY"
    if printf '%s' "$wins" | grep -qE '(^|, ?)(Typeless|Onboarding[^,]*)($|,)'; then
      chk "窗口只剩听写浮动条（开机静默形态）" 1
    else
      chk "窗口只剩听写浮动条（开机静默形态）" 0
    fi
  else
    echo "  FAIL  窗口只剩听写浮动条（读取窗口失败：AX 权限或 App 状态异常，结果未核验）"; fails=$((fails+1))
  fi
  dock="$(python3 -c 'import json,sys;v=json.load(open(sys.argv[1])).get("enableShowAppInDock",False);print("true" if v else "false")' "$SETTINGS" 2>/dev/null)"
  if [ -n "$dock" ]; then [ "$dock" = "false" ]; chk "不占 Dock（enableShowAppInDock=false）" $?
  else echo "  FAIL  不占 Dock（无法读取 ${SETTINGS}）"; fails=$((fails+1)); fi
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; chk "静默守卫已加载（launchd）" $?
  osascript -e 'tell application "System Events" to get name of every login item' 2>/dev/null | grep -q "Typeless"; chk "登录项 Typeless 存在" $?
  if [ "$fails" = 0 ]; then echo "bootcheck: 全部通过"; exit 0
  else echo "bootcheck: ${fails} 项未过（手动开着主界面时属正常，关掉后重跑）"; exit 1; fi
}

cmd_guard() {
  case "${1:-status}" in
    install)
      mkdir -p "$(dirname "$PLIST")" || die "无法创建 LaunchAgents 目录" 5
      # 已有 plist 先备份：避免新配置写坏后旧守卫已被卸载、无从回滚
      [ -f "$PLIST" ] && cp "$PLIST" "$PLIST.bak" 2>/dev/null
      cat > "$PLIST" <<EOF || die "无法写入 plist：$PLIST" 5
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>$SCRIPT_DIR/bin/typelessctl</string><string>guard</string><string>tick</string></array>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>2</integer>
    <key>ProcessType</key><string>Background</string>
    <key>Nice</key><integer>10</integer>
</dict>
</plist>
EOF
      launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
      if launchctl bootstrap "gui/$(id -u)" "$PLIST"; then
        echo "guard 已安装：App 启动后 ${GRACE_SECONDS}s 内自动弹出的主界面会被关闭"
      else
        echo "bootstrap 失败（旧守卫已卸载；若原已安装，备份在 $PLIST.bak）" >&2; exit 6
      fi
      ;;
    uninstall)
      launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
      if rm -f "$PLIST"; then echo "guard 已卸载"; else die "plist 删除失败：$PLIST" 5; fi;;
    enable)  rm -f "$STATE_DIR/PAUSED" 2>/dev/null; if [ -f "$STATE_DIR/PAUSED" ]; then die "无法删除 PAUSED，守卫仍暂停" 5; else echo "guard 已启用（resume）"; fi;;
    disable) if mkdir -p "$STATE_DIR" && touch "$STATE_DIR/PAUSED"; then echo "guard 已暂停（App 原生窗口行为恢复）"; else die "无法创建 PAUSED，守卫未暂停" 5; fi;;
    status)
      launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '/state =|pid =|last exit/{print "  "$0}' | head -3
      echo "  paused: $([ -f "$STATE_DIR/PAUSED" ] && echo yes || echo no)   grace: ${GRACE_SECONDS}s   log: $LOG_FILE";;
    tick)
      [ -f "$STATE_DIR/PAUSED" ] && exit 0
      # 防重入：系统高负载时 tick 可能跑得比 2s 间隔还慢，无锁会无限堆积进程。
      # 锁目录内含 born 文件，故释放必须用 rm -rf（rmdir 删不掉非空目录 —— 2026-10-17 修复）。
      # 锁龄超 60s 视为残留（进程被杀）自动清除。
      mkdir -p "$STATE_DIR"   # 首次安装时 STATE_DIR 可能不存在，否则 mkdir 锁会永久失败
      LOCK="$STATE_DIR/tick.lock"
      if ! mkdir "$LOCK" 2>/dev/null; then
        NOW=$(date +%s)
        # 锁龄优先读 born 文件；若 born 缺失（持有者取得锁后、写入前被杀）用锁目录自身 mtime 兜底，
        # 否则会把「无 born 的锁」每轮都当作刚创建 → 永久残留（2026-10-17 二审发现）。
        BORN="$(cat "$LOCK/born" 2>/dev/null)"
        case "$BORN" in ''|*[!0-9]*) BORN="$(stat -f %m "$LOCK" 2>/dev/null || echo "$NOW")";; esac
        case "$BORN" in ''|*[!0-9]*) BORN="$NOW";; esac
        if [ $((NOW - BORN)) -gt 60 ]; then rm -rf "$LOCK"; fi   # 清残留后让下一轮重取（本轮不再动作）
        exit 0
      fi
      date +%s > "$LOCK/born" 2>/dev/null || true
      echo "$$" > "$LOCK/owner" 2>/dev/null || true
      # 只删自己的锁：若本 tick 卡住超 60s、别的 tick 已按过期清锁并重建（owner 变成他 PID），
      # 本 trap 不得删掉继任者的锁（否则两个 tick 并发点同一按钮 —— 2026-17 二审遗留，今日 load 273
      # 时 osascript 卡 58s 使其可达，故补）。
      trap 'if [ "$(cat "$LOCK/owner" 2>/dev/null)" = "$$" ]; then rm -rf "$LOCK" 2>/dev/null; fi' EXIT
      pid="$(app_pid)"; [ -z "$pid" ] && exit 0
      secs="$(app_secs "$pid")"
      case "$secs" in ''|*[!0-9]*) exit 0;; esac   # 时长不可解析时不动作（宁可不关，不可误关）
      [ "$secs" -gt "$GRACE_SECONDS" ] && exit 0   # 意图感知：稳定运行后的窗口是你主动开的，放行
      closed="$(osascript "$APPLESCRIPT" 2>/dev/null)"
      [ -n "$closed" ] && { mkdir -p "$STATE_DIR"; printf '[%s] closed auto-hub (t+%ss): %s\n' "$(date '+%F %T')" "$secs" "$closed" >> "$LOG_FILE"; }
      exit 0;;
    *) die "用法: typelessctl guard {install|uninstall|enable|disable|status|tick}";;
  esac
}

# 白名单：只写验证过的键。App 运行中内存态可能回写覆盖，故写后读回核验（不符报 6）。
ALLOWED_KEYS="enableShowAppInDock showFlowBarOnDesktop launchAtSystemStartup historyDurationSeconds preferredLanguage autoSelectLanguages enableInteractionSoundEffects"
cmd_settings() {
  case "${1:-list}" in
    list) [ -f "$SETTINGS" ] || die "设置文件不存在（App 未安装或未首次启动）：$SETTINGS" 5
          python3 -c 'import json,sys;[print(k,"=",json.load(open(sys.argv[1])).get(k)) for k in sys.argv[2].split()]' "$SETTINGS" "$ALLOWED_KEYS";;
    get)  [ $# -ge 2 ] || die "用法: typelessctl settings get <key>"
          [ -f "$SETTINGS" ] || die "设置文件不存在（App 未安装或未首次启动）：$SETTINGS" 5
          python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],"(unset)"))' "$SETTINGS" "$2";;
    set)  [ $# -ge 3 ] || die "用法: typelessctl settings set <key> <json-value>"
          case " $ALLOWED_KEYS " in *" $2 "*) ;; *) die "键 $2 不在白名单（防写坏 schema）：$ALLOWED_KEYS" 2;; esac
          # 值是否为合法 JSON 先校验（参数错误优先于数据缺失）
          python3 -c 'import json,sys;json.loads(sys.argv[1])' "$3" 2>/dev/null || die "值不是合法 JSON（true/false/数字/\"字符串\"）：$3" 2
          [ -f "$SETTINGS" ] || die "设置文件不存在（App 未安装或未首次启动）：$SETTINGS" 5
          mkdir -p "$STATE_DIR"
          _bak="$STATE_DIR/app-settings.$(date +%Y%m%d%H%M%S).$$.bak"
          cp "$SETTINGS" "$_bak" || die "备份失败，未改动原文件：$SETTINGS" 5
          # 原子替换：写临时文件再 mv，避免 Python 直接 "w" 截断原文件后写入失败导致损坏
          _tmp="$SETTINGS.tmp.$$"
          python3 -c 'import json,sys,os,stat;f=sys.argv[1];d=json.load(open(f));d[sys.argv[2]]=json.loads(sys.argv[3]);json.dump(d,open(sys.argv[4],"w"),indent=2,ensure_ascii=False);os.chmod(sys.argv[4],stat.S_IMODE(os.stat(f).st_mode))' "$SETTINGS" "$2" "$3" "$_tmp" || { rm -f "$_tmp"; die "写入失败（原文件未改，备份在 ${_bak}）" 5; }
          mv "$_tmp" "$SETTINGS" || { rm -f "$_tmp"; die "替换失败（原文件未改，备份在 ${_bak}）" 5; }
          now="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2]))' "$SETTINGS" "$2")"
          want="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]))' "$3")"
          if [ "$now" = "$want" ]; then echo "已设置 ${2}=${now}（备份 ${_bak}）";
          else echo "写入后读回不符：${now} ≠ ${want}（App 可能正持有旧内存态；建议退出 App 后重试）" >&2; exit 6; fi;;
    *) die "用法: typelessctl settings {list|get|set}";;
  esac
}

cmd_history() {
  case "${1:-list}" in
    list)
      local n="${2:-20}"
      case "$n" in ''|*[!0-9]*) die "N 必须是正整数：$n" 2;; esac   # 参数先校验（防 LIMIT 注入）
      [ -f "$DB" ] || die "typeless.db 不存在" 5
      local out rc
      out="$(sqlite3 -readonly "$DB" "SELECT datetime(created_at), printf('%6.1fs', duration), mode, status, substr(coalesce(refined_text,''),1,48) FROM history_v2 ORDER BY created_at DESC LIMIT $n;" 2>&1)"; rc=$?
      [ $rc -ne 0 ] && die "查询失败（表缺失或库损坏）：$out" 5
      printf '%s\n' "$out"
      local cnt; cnt="$(sqlite3 -readonly "$DB" 'SELECT count(*) FROM history_v2' 2>/dev/null)" || die "读取总数失败" 5
      echo "  ——共 ${cnt} 条";;
    export)
      [ -f "$DB" ] || die "typeless.db 不存在" 5
      local out="${2:-$STATE_DIR/history-export-$(date +%Y%m%d-%H%M%S).csv}"
      mkdir -p "$(dirname "$out")"
      # 先用 600 权限创建（umask 无关），再写入；避免「先按 umask 建 644、写满后才 chmod」的明文暴露窗口。
      # 同时写到临时文件再原子 mv，避免失败时截断既有目标文件。
      local tmp="${out}.tmp.$$"
      ( umask 077; : > "$tmp" ) || die "无法创建临时导出文件：$tmp" 5
      if ! sqlite3 -readonly -header -csv "$DB" "SELECT id, created_at, updated_at, mode, status, duration, app_version, refined_text, audio_local_path FROM history_v2 ORDER BY created_at DESC;" > "$tmp" 2>/dev/null; then
        rm -f "$tmp"; die "导出失败（表缺失或库损坏；既有目标文件未被改动）" 5
      fi
      if chmod 600 "$tmp" && mv "$tmp" "$out"; then :; else rm -f "$tmp"; die "替换导出文件失败" 5; fi
      echo "已导出: ${out}（$(wc -l < "$out") 行，权限 600，仅本人可读）";;
    *) die "用法: typelessctl history {list [N]|export [文件.csv]}";;
  esac
}

usage() {
  cat <<EOF
typelessctl — Typeless for macOS 命令行控制器（非官方）

  status                     运行状态：进程/窗口/守卫/Dock 模式
  bootcheck                  开机后自检：登录自启/静默形态/守卫三件套（重启后跑一次）
  doctor                     能力与权限体检
  app launch|quit|status     启停 App
  hub close|status|show      关/看主界面（show 未实现=交给 App 托盘菜单）
  guard install|uninstall    安装/卸载静默守卫（launchd 每 2s，意图感知）
  guard enable|disable|status 守卫暂停/恢复（disable=回到 App 原生窗口行为）
  settings list|get|set      读/写 App 设置（白名单键，写后核验）
  history list [N]           最近 N 条听写历史（SQLite 直读）
  history export [csv]       全量导出 CSV（默认 ~/.typelessctl/，chmod 600）
  pause / resume             = guard disable / enable 的别名
全局：--json（仅 status 支持；须置于子命令前，如 "typelessctl --json status"）  环境变量：TYPELESSCTL_GRACE 宽限秒(默认15)
退出码：0 成功 2 用法 3 权限 4 不支持 5 数据 6 结果未核验
EOF
}

[ "${1:-}" = "--json" ] && { JSON=1; shift; }
case "${1:-}" in
  status|doctor|bootcheck|app|hub|guard|settings|history) c="$1"; shift; cmd_"$c" "$@";;
  pause) cmd_guard disable;;
  resume) cmd_guard enable;;
  version|--version) echo "typelessctl 0.1.4";;
  ""|help|--help|-h) usage;;
  *) usage; exit 2;;
esac
