#!/usr/bin/env bash
# typelessctl — Typeless for macOS 的命令行控制器（非官方工具）
# 能力通道（全部一手实测/源码定位，2026-10）：
#   AX 点关闭钮（不重启 App）、electron-store 设置读写、typeless.db 历史导出、launchd 静默守卫。
# 红线：绝不读取 app-storage.json（含账号会话）；导出的历史文件默认仅用户可读。
set -uo pipefail

APP_PATH="${TYPELESSCTL_APP_PATH:-/Applications/Typeless.app}"
APP_NAME="Typeless"
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APPLESCRIPT="$SCRIPT_DIR/lib/close-hub.applescript"
STATE_DIR="${TYPELESSCTL_STATE:-$HOME/.typelessctl}"
LOG_FILE="$STATE_DIR/guard.log"
LABEL="dev.zcode.typelessctl-guard"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
APP_SUPPORT="$HOME/Library/Application Support/Typeless"
SETTINGS="${TYPELESSCTL_SETTINGS:-$APP_SUPPORT/app-settings.json}"
DB="${TYPELESSCTL_DB:-$APP_SUPPORT/typeless.db}"
GRACE_SECONDS="${TYPELESSCTL_GRACE:-15}"
JSON=0

# 退出码契约（稳定、可脚本判断）：0 成功 2 用法错 3 权限缺 4 不支持 5 数据读写失败 6 结果未核验
die() { echo "typelessctl: $*" >&2; exit "${2:-2}"; }

app_pid()  { pgrep -x "$APP_NAME" 2>/dev/null | head -1; }
app_secs() { # 进程运行秒数；etime 形如 [[dd-]hh:]mm:ss
  local et; et="$(ps -p "$1" -o etime= | tr -d ' ')"
  printf '%s' "$et" | awk '{s=$0;d=0;if(index(s,"-")){split(s,p,"-");d=p[1]+0;s=p[2]}
    n=split(s,c,":");if(n==3)print d*86400+c[1]*3600+c[2]*60+c[3];else print d*86400+c[1]*60+c[2]}'
}
windows() { osascript -e "tell application \"System Events\" to tell process \"$APP_NAME\" to get name of every window" 2>/dev/null; }

cmd_status() {
  local pid et secs wins guard dock
  pid="$(app_pid)"
  if [ -n "$pid" ]; then
    et="$(app_secs "$pid")"; wins="$(windows)"; guard="unknown"
  else pid="(not running)"; et=""; wins=""; fi
  guard="$(launchctl list 2>/dev/null | awk -v l="$LABEL" '$3==l{print "loaded (last exit "$2")"}' || true)"
  [ -z "$guard" ] && guard="not installed"
  dock="$(python3 -c 'import json,sys;v=json.load(open(sys.argv[1])).get("enableShowAppInDock",False);print("true" if v else "false")' "$SETTINGS" 2>/dev/null)"
  if [ "$JSON" = 1 ]; then
    printf '{"running":%s,"pid":"%s","uptime_seconds":"%s","windows":"%s","guard":"%s","show_in_dock":%s}\n' \
      "$([ -n "$(app_pid)" ] && echo true || echo false)" "${pid}" "${et}" "${wins//\"/}" "${guard//\"/}" "${dock:-false}"
  else
    echo "app:        ${pid} $([ -n "$(app_pid)" ] && echo "(running ${et}s)")"
    echo "windows:    ${wins:-（无/未运行）}"
    echo "guard:      $guard"
    echo "dock:       enableShowAppInDock=${dock}（false=不进 Dock）"
    echo "state:      $STATE_DIR  paused=$([ -f "$STATE_DIR/PAUSED" ] && echo yes || echo no)"
  fi
}

cmd_doctor() {
  check() { # check <能力> <available|unsupported|permission_required|missing> <说明>
    printf '  %-18s %-19s %s\n' "$1" "$2" "$3"
  }
  echo "typelessctl doctor"
  local ver; ver="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP_PATH/Contents/Info.plist" 2>/dev/null)"
  if [ -d "$APP_PATH" ]; then check "app-installed" available "$APP_PATH (v${ver:-?})"
  else check "app-installed" missing "$APP_PATH 不存在"; fi
  if [ ! -f "$APPLESCRIPT" ]; then check "cli-assets" missing "close-hub.applescript 不在 $APPLESCRIPT"; fi
  if osascript -e 'tell application "System Events" to get name of first process' >/dev/null 2>&1; then
    check "accessibility(AX)" available "System Events 可控窗（终端需辅助功能授权）"
  else
    check "accessibility(AX)" permission_required "请：系统设置→隐私与安全性→辅助功能，勾选你运行本命令的终端"
  fi
  if [ -f "$SETTINGS" ]; then check "settings-json" available "$SETTINGS"
  else check "settings-json" missing "App 尚未生成设置文件"; fi
  if [ -f "$DB" ] && sqlite3 -readonly "$DB" "SELECT count(*) FROM history_v2;" >/dev/null 2>&1; then
    check "history-db" available "$(sqlite3 -readonly "$DB" 'SELECT count(*) FROM history_v2' 2>/dev/null) 条记录（明文可读）"
  else check "history-db" missing "typeless.db 不可读或表缺失"; fi
  if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
    check "guard" available "launchd 已注册，每 2s 巡查"
  else
    check "guard" missing "运行: typelessctl guard install"
  fi
  [ "$JSON" = 1 ] && echo "（--json doctor 输出开发中，当前为表格）"
  echo "注：CDP 调试端口/改包两条通道已被证实不可用，本工具不依赖。"
}

cmd_app() {
  case "${1:-status}" in
    launch) open -a "$APP_PATH";;
    quit)   osascript -e "tell application \"$APP_NAME\" to quit" 2>/dev/null;;
    status) cmd_status;;
    *) die "用法: typelessctl app {launch|quit|status}";;
  esac
}

cmd_hub() {
  case "${1:-status}" in
    close)
      local closed; closed="$(osascript "$APPLESCRIPT" 2>/dev/null)"
      if [ -n "$closed" ]; then echo "已关闭: $closed";
      elif [ -z "$(windows)" ]; then echo "App 未运行"; exit 6;
      else echo "没有可关的 hub/引导窗口（Status 听写条不动）"; fi;;
    status) windows;;
    show) die "hub show 未验证：手动唤回主界面的原生入口是 App 托盘菜单（GUI），CLI 不模拟焦点操作。临时放行：typelessctl pause" 4;;
    *) die "用法: typelessctl hub {close|status|show}";;
  esac
}

cmd_bootcheck() {
  # 开机后专用自检：验证「登录自启 + 静默 + 守卫」三件套是否如期。重启后跑一次即可。
  # 约定：chk 第二参为 shell 退出码语义，0=真=PASS。
  local fails=0
  chk() { if [ "$2" = 0 ]; then echo "  PASS  $1"; else echo "  FAIL  $1"; fails=$((fails+1)); fi; }
  echo "typelessctl bootcheck"
  local pid wins dock
  pid="$(app_pid)"
  [ -n "$pid" ]; chk "App 进程在跑（登录项自启生效）" $?
  wins="$(windows)"
  if printf '%s' "$wins" | grep -qE '(^|, ?)(Typeless|Onboarding)($|,)'; then
    chk "窗口只剩听写浮动条（开机静默形态）" 1
  else
    chk "窗口只剩听写浮动条（开机静默形态）" 0
  fi
  dock="$(python3 -c 'import json,sys;v=json.load(open(sys.argv[1])).get("enableShowAppInDock",False);print("true" if v else "false")' "$SETTINGS" 2>/dev/null)"
  [ "$dock" = "false" ]; chk "不占 Dock（enableShowAppInDock=false）" $?
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; chk "静默守卫已加载（launchd）" $?
  osascript -e 'tell application "System Events" to get name of every login item' 2>/dev/null | grep -q "Typeless"; chk "登录项 Typeless 存在" $?
  if [ "$fails" = 0 ]; then echo "bootcheck: 全部通过"; exit 0
  else echo "bootcheck: $fails 项未过（手动开着主界面时属正常，关掉后重跑）"; exit 1; fi
}

cmd_guard() {
  case "${1:-status}" in
    install)
      cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>$SCRIPT_DIR/bin/typelessctl</string><string>guard</string><string>tick</string></array>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>2</integer>
    <key>ProcessType</key><string>Background</string>
    <key>Nice</key><integer>10</integer>
</dict>
</plist>
EOF
      launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
      if launchctl bootstrap "gui/$(id -u)" "$PLIST"; then
        echo "guard 已安装：App 启动后 ${GRACE_SECONDS}s 内自动弹出的主界面会被关闭"
      else
        echo "bootstrap 失败（可能已加载或 plist 非法）" >&2; exit 6
      fi
      ;;
    uninstall) launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null; rm -f "$PLIST"; echo "guard 已卸载";;
    enable)  rm -f "$STATE_DIR/PAUSED"; echo "guard 已启用（resume）";;
    disable) mkdir -p "$STATE_DIR"; touch "$STATE_DIR/PAUSED"; echo "guard 已暂停（App 原生窗口行为恢复）";;
    status)
      launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '/state =|pid =|last exit/{print "  "$0}' | head -3
      echo "  paused: $([ -f "$STATE_DIR/PAUSED" ] && echo yes || echo no)   grace: ${GRACE_SECONDS}s   log: $LOG_FILE";;
    tick)
      [ -f "$STATE_DIR/PAUSED" ] && exit 0
      pid="$(app_pid)"; [ -z "$pid" ] && exit 0
      secs="$(app_secs "$pid")"
      [ "$secs" -gt "$GRACE_SECONDS" ] && exit 0   # 意图感知：稳定运行后的窗口是你主动开的，放行
      closed="$(osascript "$APPLESCRIPT" 2>/dev/null)"
      [ -n "$closed" ] && { mkdir -p "$STATE_DIR"; printf '[%s] closed auto-hub (t+%ss): %s\n' "$(date '+%F %T')" "$secs" "$closed" >> "$LOG_FILE"; }
      exit 0;;
    *) die "用法: typelessctl guard {install|uninstall|enable|disable|status|tick}";;
  esac
}

# 白名单：只写验证过的键。App 运行中内存态可能回写覆盖，故写后读回核验（不符报 6）。
ALLOWED_KEYS="enableShowAppInDock showFlowBarOnDesktop launchAtSystemStartup historyDurationSeconds preferredLanguage autoSelectLanguages enableInteractionSoundEffects"
cmd_settings() {
  case "${1:-list}" in
    list) [ -f "$SETTINGS" ] || die "设置文件不存在（App 未安装或未首次启动）：$SETTINGS" 5
          python3 -c 'import json,sys;[print(k,"=",json.load(open(sys.argv[1])).get(k)) for k in sys.argv[2].split()]' "$SETTINGS" "$ALLOWED_KEYS";;
    get)  [ $# -ge 2 ] || die "用法: typelessctl settings get <key>"
          [ -f "$SETTINGS" ] || die "设置文件不存在（App 未安装或未首次启动）：$SETTINGS" 5
          python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],"(unset)"))' "$SETTINGS" "$2";;
    set)  [ $# -ge 3 ] || die "用法: typelessctl settings set <key> <json-value>"
          case " $ALLOWED_KEYS " in *" $2 "*) ;; *) die "键 $2 不在白名单（防写坏 schema）：$ALLOWED_KEYS" 2;; esac
          [ -f "$SETTINGS" ] || die "设置文件不存在（App 未安装或未首次启动）：$SETTINGS" 5
          cp "$SETTINGS" "$STATE_DIR/app-settings.$(date +%Y%m%d%H%M%S).bak" 2>/dev/null || mkdir -p "$STATE_DIR" && cp "$SETTINGS" "$STATE_DIR/app-settings.$(date +%Y%m%d%H%M%S).bak"
          python3 -c 'import json,sys;f=sys.argv[1];d=json.load(open(f));d[sys.argv[2]]=json.loads(sys.argv[3]);json.dump(d,open(f,"w"),indent=2,ensure_ascii=False)' "$SETTINGS" "$2" "$3" || die "写入失败（键值需为合法 JSON：true/false/数字/字符串）" 5
          now="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2]))' "$SETTINGS" "$2")"
          want="$(python3 -c 'import json,sys;print(json.loads(sys.argv[1]))' "$3")"
          if [ "$now" = "$want" ]; then echo "已设置 $2=$now";
          else echo "写入后读回不符：$now ≠ $want（App 可能正持有旧内存态；建议退出 App 后重试）" >&2; exit 6; fi;;
    *) die "用法: typelessctl settings {list|get|set}";;
  esac
}

cmd_history() {
  [ -f "$DB" ] || die "typeless.db 不存在" 5
  case "${1:-list}" in
    list)
      local n="${2:-20}"
      sqlite3 -readonly "$DB" "SELECT datetime(created_at), printf('%6.1fs', duration), mode, status, substr(coalesce(refined_text,''),1,48) FROM history_v2 ORDER BY created_at DESC LIMIT $n;"
      echo "  ——共 $(sqlite3 -readonly "$DB" 'SELECT count(*) FROM history_v2') 条";;
    export)
      local out="${2:-$STATE_DIR/history-export-$(date +%Y%m%d-%H%M%S).csv}"
      mkdir -p "$(dirname "$out")"
      sqlite3 -readonly -header -csv "$DB" "SELECT id, created_at, updated_at, mode, status, duration, app_version, refined_text, audio_local_path FROM history_v2 ORDER BY created_at DESC;" > "$out" || die "导出失败" 5
      chmod 600 "$out"   # 含听写明文，默认仅用户可读
      echo "已导出: $out（$(wc -l < "$out") 行，chmod 600）";;
    *) die "用法: typelessctl history {list [N]|export [文件.csv]}";;
  esac
}

usage() {
  cat <<EOF
typelessctl — Typeless for macOS 命令行控制器（非官方）

  status                     运行状态：进程/窗口/守卫/Dock 模式
  bootcheck                  开机后自检：登录自启/静默形态/守卫三件套（重启后跑一次）
  doctor                     能力与权限体检
  app launch|quit|status     启停 App
  hub close|status|show      关/看主界面（show 未实现=交给 App 托盘菜单）
  guard install|uninstall    安装/卸载静默守卫（launchd 每 2s，意图感知）
  guard enable|disable|status 守卫暂停/恢复（disable=回到 App 原生窗口行为）
  settings list|get|set      读/写 App 设置（白名单键，写后核验）
  history list [N]           最近 N 条听写历史（SQLite 直读）
  history export [csv]       全量导出 CSV（默认 ~/.typelessctl/，chmod 600）
  pause / resume             = guard disable / enable 的别名
全局：--json（status/history list）  环境变量：TYPELESSCTL_GRACE 宽限秒(默认15)
退出码：0 成功 2 用法 3 权限 4 不支持 5 数据 6 结果未核验
EOF
}

[ "${1:-}" = "--json" ] && { JSON=1; shift; }
case "${1:-}" in
  status|doctor|bootcheck|app|hub|guard|settings|history) c="$1"; shift; cmd_"$c" "$@";;
  pause) cmd_guard disable;;
  resume) cmd_guard enable;;
  version|--version) echo "typelessctl 0.1.0";;
  ""|help|--help|-h) usage;;
  *) usage; exit 2;;
esac
